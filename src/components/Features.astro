---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { features } = t;

const icons: Record<string, string> = {
  ai: '<path d="M12 3.5 13.6 8 18 9.6 13.6 11.2 12 15.7 10.4 11.2 6 9.6 10.4 8 12 3.5Z"/><path d="M18.5 15.5 19.2 17.3 21 18l-1.8.7-.7 1.8-.7-1.8L16 18l1.8-.7.7-1.8Z"/><path d="M5.5 14 6.1 15.6 7.7 16.2 6.1 16.8 5.5 18.4 4.9 16.8 3.3 16.2 4.9 15.6 5.5 14Z"/>',
  clients:
    '<path d="M9.5 11.5a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z"/><path d="M3.5 19.5c0-3 2.7-4.75 6-4.75s6 1.75 6 4.75"/><path d="M16 5.6a3.25 3.25 0 0 1 0 5.9"/><path d="M18 14.9c1.6.6 2.5 1.9 2.5 3.5"/>',
  pipeline:
    '<rect x="3.5" y="4.5" width="5" height="15" rx="1.5"/><rect x="10.5" y="4.5" width="5" height="10" rx="1.5"/><rect x="17.5" y="4.5" width="3" height="7" rx="1.5"/>',
  docs: '<path d="M14 3.5H7a1.5 1.5 0 0 0-1.5 1.5v14A1.5 1.5 0 0 0 7 20.5h10a1.5 1.5 0 0 0 1.5-1.5V8L14 3.5Z"/><path d="M13.75 3.75V8.25h4.5"/><path d="M9 14.5l1.75 1.75L14.5 12.5"/>',
  followups:
    '<rect x="3.5" y="5.5" width="17" height="15" rx="2"/><path d="M3.5 10h17"/><path d="M8 3.5v4M16 3.5v4"/><path d="M9 15.25h6"/>',
  email:
    '<rect x="3" y="6" width="14" height="10" rx="2"/><path d="M3.6 7 10 11.75 16.4 7"/><path d="M19.5 10.5h1.5M19.5 13.5h1.5M19.5 16.5h1.5"/>',
};

const spans: Record<string, string> = {
  ai: 'md:col-span-2 lg:col-span-2',
  email: 'md:col-span-2 lg:col-span-3',
};
---

<section id="features" class="relative px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <header class="max-w-2xl">
      <p class="reveal text-[13px] font-medium text-blue-400">{features.eyebrow}</p>
      <h2
        class="reveal mt-3 text-balance text-3xl font-semibold text-white sm:text-[2.6rem]"
        style="--delay: 60ms"
      >
        {features.title}
      </h2>
      <p class="reveal mt-4 text-pretty text-[15px] leading-relaxed text-slate-400" style="--delay: 120ms">
        {features.subtitle}
      </p>
    </header>

    <div class="mt-12 grid gap-3 md:grid-cols-2 lg:grid-cols-3 sm:mt-14">
      {
        features.items.map((item, index) => {
          const isAi = item.key === 'ai';
          return (
            <article
              class:list={[
                'reveal group relative overflow-hidden rounded-2xl p-6 ring-1 transition-colors duration-200 sm:p-7',
                spans[item.key] ?? '',
                isAi
                  ? 'bg-violet-500/[0.07] ring-violet-400/20 hover:bg-violet-500/[0.1]'
                  : 'bg-white/[0.03] ring-white/10 hover:bg-white/[0.05]',
              ]}
              style={`--delay: ${index * 60}ms`}
            >
              {isAi && (
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute -right-16 -top-16 size-52 rounded-full bg-violet-500/15 blur-3xl"
                />
              )}

              <span
                class:list={[
                  'relative grid size-10 place-items-center rounded-xl ring-1',
                  isAi
                    ? 'bg-violet-500/15 text-violet-300 ring-violet-400/25'
                    : 'bg-white/5 text-slate-400 ring-white/10',
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class="size-5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[item.key]}
                />
              </span>

              <h3
                class:list={[
                  'relative mt-5 text-[15px] font-semibold',
                  isAi ? 'text-violet-50' : 'text-white',
                ]}
              >
                {item.title}
              </h3>
              <p class="relative mt-2 max-w-lg text-pretty text-sm leading-relaxed text-slate-400">
                {item.body}
              </p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
